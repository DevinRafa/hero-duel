@startuml
skinparam dpi 200
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam ArrowColor #333333
skinparam SequenceLifeLineBorderColor #7F7F7F
skinparam SequenceGroupBorderColor #7F7F7F
skinparam SequenceBoxBorderColor #7F7F7F
skinparam SequenceBoxBackgroundColor #FAFAFA
skinparam ParticipantBorderColor #262626
skinparam ParticipantBackgroundColor #F2F2F2
skinparam ActorBorderColor #262626
skinparam ActorBackgroundColor #F2F2F2
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #7F7F7F
skinparam SequenceMessageAlignment left
skinparam sequenceArrowThickness 1
autonumber "<b>0"

actor "Pemain" as Pemain
box "duelpahlawan.ui"
participant "jendela :\nJendelaUtama" as UI
participant "panelPahlawan :\nPanelKarakter" as PP
participant "panelLawan :\nPanelKarakter" as PL
end box
box "duelpahlawan.model"
participant "duel :\nPertarungan" as P
participant "pahlawan :\nPenyihir" as H
participant "lawan :\nMonster" as M
end box

Pemain -> UI : klik tombol "Sembuhkan"
activate UI
UI -> UI : klikSembuhkan()
UI -> P : pahlawanMenyembuhkan()
activate P
P -> P : pastikanBerlangsung()
alt pahlawanBisaMenyembuhkan() = true
  P -> H : sembuhkan(pahlawan)
  activate H
  note right of H
    Reference bertipe BisaMenyembuhkan
    menunjuk object Penyihir.
  end note
  H -> H : pastikanHidup()
  H -> H : pulihkanHp(25)
  H --> P : jumlah pulih
  deactivate H
  P -> P : catat("... menyembuhkan diri ...")
  P -> M : serang(pahlawan)
  activate M
  M -> H : terimaDamage(damage)
  M --> P : damage
  deactivate M
  P -> P : catat("... membalas ...")
  P -> P : periksaPemenang()
  P --> UI
else pahlawanBisaMenyembuhkan() = false
  P --> UI : IllegalStateException
  note over UI
    Ditangkap try-catch -> tampilkanPesan(), lalu return (tanpa animasi).
    Tombol "Sembuhkan" juga disembunyikan
    untuk pahlawan selain Penyihir.
  end note
end
deactivate P

UI -> UI : putarGiliran(SEMBUH, hpAwal, awalLog)
UI -> P : getRiwayat()
P --> UI : riwayat
UI -> UI : ambilAngka(riwayat)
UI -> PP : mainkan(SEMBUH, callback)
PP --> UI : callback selesai
UI -> PP : setHp(), tampilkanAngka("+13")
UI -> PL : mainkan(SERANG, callback)
PL --> UI : callback selesai
UI -> PP : setHp(), tampilkanAngka("-12")
UI -> PP : mainkan(TERLUKA, callback)
PP --> UI : callback selesai
UI -> UI : akhiriGiliran()
UI --> Pemain : HP, log, dan animasi diperbarui
deactivate UI
@enduml
