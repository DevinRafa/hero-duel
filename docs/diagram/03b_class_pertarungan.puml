@startuml
skinparam dpi 200
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam roundCorner 4
skinparam ArrowColor #333333
skinparam ClassBackgroundColor #F2F2F2
skinparam ClassBorderColor #262626
skinparam stereotypeCBackgroundColor #FFFFFF
hide circle
hide empty members
skinparam nodesep 25
skinparam ranksep 35

class JFrame <<javax.swing>>
class JPanel <<javax.swing>>

class Main <<duelpahlawan.ui>> {
  +{static} main(args : String[]) : void
}

class JendelaUtama <<duelpahlawan.ui>> {
  -pertarungan : Pertarungan
  -panelPahlawan : PanelKarakter
  -panelLawan : PanelKarakter
  -sibuk : boolean
  -klikMulai(jenis : String) : void
  -klikSerang() : void
  -klikSembuhkan() : void
  -klikUlangi() : void
  -putarGiliran(aksiPahlawan : AksiSprite,\n    hpAwal : int[], awalLog : int) : void
  -terkena(panel : PanelKarakter, hpBaru : int,\n    damage : int, lanjut : Runnable) : void
  -akhiriGiliran() : void
  -aturTombol() : void
}

class PanelKarakter <<duelpahlawan.ui>> {
  -sprite : AnimasiSprite
  -aksi : AksiSprite
  -indeksFrame : int
  +PanelKarakter(karakter : Karakter, hadapKanan : boolean)
  +setHp(hp : int, hpMaks : int) : void
  +mainkan(aksiBaru : AksiSprite,\n    setelahSelesai : Runnable) : void
  +tampilkanAngka(teks : String, warna : Color) : void
  +hentikan() : void
}

class KartuKarakter <<duelpahlawan.ui>> {
  -sprite : AnimasiSprite
  -indeksFrame : int
  +KartuKarakter(contoh : Karakter, deskripsi : String,\n    warnaLatar : Color, warnaTombol : Color,\n    saatDipilih : Runnable)
}

class AnimasiSprite <<duelpahlawan.ui>> {
  -frame : Map<AksiSprite, BufferedImage[]>
  -lebarFrame : int
  -menghadapKanan : boolean
  +{static} untuk(karakter : Karakter) : AnimasiSprite
  +punya(aksi : AksiSprite) : boolean
  +jumlahFrame(aksi : AksiSprite) : int
  +getFrame(aksi : AksiSprite, indeks : int)\n    : BufferedImage
  +getLebarFrame() : int
  +isMenghadapKanan() : boolean
}

enum AksiSprite <<duelpahlawan.ui>> {
  IDLE
  SERANG
  TERLUKA
  MATI
  SEMBUH
  MENANG
}

class Pertarungan <<duelpahlawan.model>> {
  -pahlawan : Karakter
  -lawan : Karakter
  -riwayat : List<String>
  -giliran : int
  -pemenang : Karakter
  +Pertarungan(pahlawan : Karakter, lawan : Karakter)
  +pahlawanMenyerang() : void
  +pahlawanMenyembuhkan() : void
  +pahlawanBisaMenyembuhkan() : boolean
  -akhiriGiliran() : void
  -periksaPemenang() : void
  -pastikanBerlangsung() : void
  -catat(pesan : String) : void
  +isSelesai() : boolean
  +getPemenang() : Karakter
  +getPahlawan() : Karakter
  +getLawan() : Karakter
  +getGiliran() : int
  +getRiwayat() : List<String>
}

abstract class Karakter <<abstract>>

JFrame <|-- JendelaUtama
JPanel <|-- PanelKarakter
JPanel <|-- KartuKarakter
Main ..> JendelaUtama : membuka >
JendelaUtama --> "1" Pertarungan : mengelola >
JendelaUtama *-- "2" PanelKarakter : menampilkan >
JendelaUtama ..> KartuKarakter : membuat 2 kartu >
PanelKarakter *-- "1" AnimasiSprite
KartuKarakter *-- "1" AnimasiSprite
AnimasiSprite ..> AksiSprite
PanelKarakter ..> AksiSprite
AnimasiSprite ..> Karakter : memilih sprite >
Pertarungan "1" o-- "2" Karakter : melibatkan >
@enduml
