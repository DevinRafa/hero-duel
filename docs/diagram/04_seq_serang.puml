@startuml
skinparam dpi 200
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam ArrowColor #333333
skinparam SequenceLifeLineBorderColor #7F7F7F
skinparam SequenceGroupBorderColor #7F7F7F
skinparam ParticipantBorderColor #262626
skinparam ParticipantBackgroundColor #F2F2F2
skinparam ActorBorderColor #262626
skinparam ActorBackgroundColor #F2F2F2
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #7F7F7F
skinparam SequenceMessageAlignment left
skinparam sequenceArrowThickness 1
autonumber "<b>0"

actor "Pemain" as Pemain
participant "jendela : JendelaUtama" as UI
participant "duel : Pertarungan" as P
participant "pahlawan : Ksatria" as H
participant "lawan : Monster" as M

Pemain -> UI : klik tombol "Serang"
activate UI
UI -> P : pahlawanMenyerang()
activate P
P -> P : pastikanBerlangsung()
P -> H : serang(lawan)
activate H
H -> H : pastikanHidup()
H -> M : terimaDamage(15)
activate M
M --> H
deactivate M
H --> P : damage = 15
deactivate H
note right of H
  Reference bertipe Karakter,
  object bertipe Ksatria:
  yang dijalankan serang() milik Ksatria
  (dynamic method dispatch).
end note
P -> P : catat("... menyerang ...")

alt lawan.masihHidup() = true
  P -> M : serang(pahlawan)
  activate M
  M -> H : terimaDamage(damage)
  activate H
  H --> M
  deactivate H
  M --> P : damage
  deactivate M
  P -> P : catat("... membalas ...")
else lawan.masihHidup() = false
  note over P : Monster kalah, tidak membalas
end

P -> P : periksaPemenang()
P --> UI
deactivate P
UI -> P : getRiwayat(), getPahlawan(), getLawan()
P --> UI
UI -> UI : perbaruiTampilan()
UI --> Pemain : HP dan log diperbarui
deactivate UI
@enduml
